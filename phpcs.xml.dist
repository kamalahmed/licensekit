<?xml version="1.0"?>
<ruleset name="LicenseKit">
    <description>
        Lint rules for LicenseKit. Scoped to WordPress.org's Plugin Check (PCP)
        ruleset — the same checks that gate WP.org submission. Stricter
        WordPress-Extra rules can be enabled progressively over time.
    </description>

    <file>licensekit.php</file>
    <file>uninstall.php</file>
    <file>src/</file>
    <file>client-sdk/licensekit-client.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>client-sdk/examples/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <!--
        WordPress.org submission ruleset for headless CI. The full Plugin
        Check (PCP) sniffs ship inside the WP "Plugin Check" plugin and run
        from the admin UI; the rules below cover the same WordPress coding
        standards checks via wpcs alone, so CI doesn't need that plugin.
    -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <!-- Capabilities provided by host plugins (EDD/WooCommerce) that the sniff doesn't know about. -->
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
                <element value="manage_shop_settings"/>
                <element value="view_woocommerce_reports"/>
                <element value="manage_shop_orders"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.DB.RestrictedFunctions"/>
    <rule ref="WordPress.DB.SlowDBQuery"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.EnqueuedResourceParameters"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
